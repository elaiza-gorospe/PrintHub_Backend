generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          Int      @id @default(autoincrement())
  first_name  String?  @map("first_name")
  last_name   String?  @map("last_name")
  email       String   @unique
  password    String
  phone       String?
  address     String?
  role        Int
  status      String? 
  last_login  DateTime? @map("last_login")
  join_date   DateTime? @map("join_date")
  gender      String?
  birthday    DateTime?
  avatar_url  String?  @map("avatar_url")
  position    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  orders       Order[]
  inquiries    Inquiry[]
  cartItems    CartItem[]
}

model ArchivedUser {
  id          Int      @id @default(autoincrement())
  user_id     Int?     @map("user_id")
  first_name  String?  @map("first_name")
  last_name   String?  @map("last_name")
  phone       String?
  address     String?
  email       String
  password    String
  role        Int?
  status      String?
  last_login  DateTime?
  join_date   DateTime?
  gender      String?
  birthday    DateTime?
  position    String?
  archived_at DateTime?
}

model Product {
  id           Int       @id @default(autoincrement())
  name         String
  sku          String?   @unique
  description  String?
  price        Decimal   @db.Decimal(12,2)
  currency     String    @default("PHP")
  stock        Int       @default(0)
  width_mm     Int?
  height_mm    Int?
  depth_mm     Int?
  material     String?
  colorOptions String[]  @default([])
  color_options      String[]  @default([])
  size_options       String[]  @default([])
  material_options   String[]  @default([])
  side_options       String[]  @default([])
  finishing_options  String[]  @default([])
  processing_options String[]  @default([])
  delivery_options   String[]  @default([])
  quantity_options   String[]  @default([])
  shipping_options   String[]  @default([])
  print_type   String?   // e.g. digital, offset, screen
  turnaround_hours Int?
  ai_prompt_rules String?  // strict AI generation/design rules for this product category
  print_zones  String[]  @default([])  // e.g. ["front","back","left_sleeve","right_sleeve"]
  category     String?   @default("other")  // tshirt | mug | calling_card | other
  images       String[]  @default([])
  quantity_mode String?   // 'dropdown' | 'text' — admin-configurable quantity input mode
  quantity_count Int?     // threshold for auto-selecting contact/quote when using text mode
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deleted_at   DateTime? @map("deleted_at")

  orderItems   OrderItem[]
  cartItems    CartItem[]
}

model Order {
  id              Int         @id @default(autoincrement())
  user            User?       @relation(fields: [userId], references: [id])
  userId          Int?
  total           Decimal     @db.Decimal(14,2)
  currency        String      @default("PHP")
  status          String      @default("pending")
  shipping_address String?
  billing_address String?
  proofApproved        Boolean     @default(false)
  payment_status       String      @default("unpaid")
  payment_method       String?
  payment_reference    String?
  paymongo_session_id  String?
  checkout_url         String?
  due_date             DateTime?
  delivered_at         DateTime?
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  deleted_at           DateTime?   @map("deleted_at")

  items           OrderItem[]
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  order        Order    @relation(fields: [orderId], references: [id])
  orderId      Int
  product      Product  @relation(fields: [productId], references: [id])
  productId    Int
  quantity     Int      @default(1)
  unit_price   Decimal  @db.Decimal(14,2)
  total_price  Decimal  @db.Decimal(14,2)
  customizations Json?
  createdAt    DateTime @default(now())
}

model CartItem {
  id             Int      @id @default(autoincrement())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId      Int?
  title          String
  price          Decimal  @db.Decimal(14,2)
  qty            Int      @default(1)
  productImage   String?
  customizations Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([productId])
}

model Inquiry {
  id            Int       @id @default(autoincrement())
  userId        Int?      @map("user_id")
  user          User?     @relation(fields: [userId], references: [id])
  product_title String?
  subject       String
  name          String
  email         String
  quantity      String?
  size          String?
  color         String?
  material      String?
  finishing     String?
  printing      String?
  processing    String?
  delivery      String?
  other         String?
  status        String    @default("new")
  quoted_price  Decimal?  @db.Decimal(14,2)
  admin_notes   String?
  order_id      Int?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
}

